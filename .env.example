APP_NAME="El Marché"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Tunis
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=fr
APP_SUPPORTED_LOCALES=ar,fr,en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Postgres is recommended: the listing attribute store uses a JSON column
# and the seeders assume case-insensitive search behaviour.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=green_marketplace
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@elmarche.tn"
MAIL_FROM_NAME="${APP_NAME}"

# Marketplace settings
MARKETPLACE_CURRENCY=TND
MARKETPLACE_VAT_RATE=19
MARKETPLACE_COMMISSION_RATE=10
MARKETPLACE_CREDENTIAL_REMINDER_DAYS=60,30,7
MARKETPLACE_PARTICIPANT_PURGE_DAYS=30
